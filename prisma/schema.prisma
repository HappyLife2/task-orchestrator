generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
  apiKeys      ApiKey[]
  dashboards   Dashboard[]
  departments  Department[]
  documents    Document[]
  users        User[]
  workforms    Workform[]
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String?
  position         String?
  role             String            @default("USER")
  organizationId   String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  avatarUrl        String?
  boardMembers     BoardMember[]
  documentVersions DocumentVersion[]
  favorites        Favorite[]
  notifications    Notification[]
  permissions      Permission[]
  recentItems      RecentItem[]
  tasks            Task[]
  createdTasks     Task[]            @relation("TaskCreator")
  timeEntries      TimeEntry[]
  updates          Update[]
  updateReactions  UpdateReaction[]
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  watchedItems     WatchedItem[]
}

model Department {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  boards         Board[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Board {
  id           String        @id @default(uuid())
  name         String
  departmentId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  columns      String        @default("[]")
  color        String?
  description  String?
  icon         String?
  automations  Automation[]
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  members      BoardMember[]
  views        BoardView[]
  discussions  Discussion[]
  favorites    Favorite[]
  groups       Group[]
  permissions  Permission[]
  tasks        Task[]
  templates    Template[]

  @@index([departmentId])
}

model Group {
  id        String   @id @default(uuid())
  boardId   String
  title     String
  color     String?
  position  Int      @default(0)
  collapsed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId])
  @@index([position])
}

model BoardMember {
  id        String   @id @default(uuid())
  boardId   String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([boardId])
  @@index([userId])
}

model Task {
  id             String        @id @default(uuid())
  name           String
  state          String        @default("ACTIVE")
  boardId        String
  groupId        String?
  assignedUserId String?
  referenceId    String?
  externalId     String?
  description    String?
  creatorId      String?
  columnValues   String        @default("{}")
  position       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  parentTaskId   String?
  parentTask     Task?         @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks       Task[]        @relation("SubTasks")
  assignedUser   User?         @relation(fields: [assignedUserId], references: [id])
  group          Group?        @relation(fields: [groupId], references: [id])
  board          Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  creator        User?         @relation("TaskCreator", fields: [creatorId], references: [id])
  timeEntries    TimeEntry[]
  updates        Update[]
  watchedItems   WatchedItem[]

  @@index([boardId])
  @@index([groupId])
  @@index([assignedUserId])
  @@index([referenceId])
  @@index([externalId])
  @@index([creatorId])
  @@index([position])
}

model Update {
  id        String           @id @default(uuid())
  content   String
  taskId    String
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  parentId  String?
  parent    Update?          @relation("UpdateReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Update[]         @relation("UpdateReplies")
  user      User             @relation(fields: [userId], references: [id])
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reactions UpdateReaction[]

  @@index([taskId])
  @@index([userId])
}

model UpdateReaction {
  id        String   @id @default(uuid())
  updateId  String
  userId    String
  emoji     String   @default("❤️")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  update    Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@unique([updateId, userId])
  @@index([updateId])
  @@index([userId])
}

model BoardView {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  type      String
  settings  String   @default("{}")
  position  Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model Dashboard {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  description    String?
  layout         String            @default("[]")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widgets        DashboardWidget[]
  permissions    Permission[]

  @@index([organizationId])
}

model DashboardWidget {
  id          String    @id @default(uuid())
  dashboardId String
  type        String
  title       String
  config      String    @default("{}")
  position    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}

model Automation {
  id         String          @id @default(uuid())
  boardId    String
  name       String
  trigger    String
  conditions String          @default("[]")
  actions    String          @default("[]")
  enabled    Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  board      Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  logs       AutomationLog[]

  @@index([boardId])
  @@index([enabled])
}

model AutomationLog {
  id           String     @id @default(uuid())
  automationId String
  taskId       String?
  status       String
  details      String?
  executedAt   DateTime   @default(now())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([executedAt])
}

model Template {
  id          String   @id @default(uuid())
  boardId     String?
  name        String
  description String?
  category    String?
  isPublic    Boolean  @default(false)
  config      String
  thumbnail   String?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  board       Board?   @relation(fields: [boardId], references: [id])

  @@index([category])
  @@index([isPublic])
}

model Workform {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  description    String?
  boardId        String?
  fields         String               @default("[]")
  settings       String               @default("{}")
  isPublic       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions    WorkformSubmission[]

  @@index([organizationId])
}

model WorkformSubmission {
  id         String   @id @default(uuid())
  workformId String
  data       String
  taskId     String?
  createdAt  DateTime @default(now())
  workform   Workform @relation(fields: [workformId], references: [id], onDelete: Cascade)

  @@index([workformId])
  @@index([createdAt])
}

model Permission {
  id           String    @id @default(uuid())
  userId       String
  resourceType String
  resourceId   String
  role         String
  settings     String    @default("{}")
  createdAt    DateTime  @default(now())
  board        Dashboard @relation(fields: [resourceId], references: [id])
  board        Board     @relation(fields: [resourceId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([resourceId])
}

model TimeEntry {
  id          String    @id @default(uuid())
  taskId      String
  userId      String
  hours       Float
  description String?
  isBillable  Boolean   @default(false)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model Document {
  id             String            @id @default(uuid())
  organizationId String
  title          String
  content        String            @default("")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       DocumentVersion[]

  @@index([organizationId])
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  content    String
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  content   String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model WatchedItem {
  id        String   @id @default(uuid())
  userId    String
  taskId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
}

model Discussion {
  id        String   @id @default(uuid())
  boardId   String
  title     String
  content   String
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model Favorite {
  id           String   @id @default(uuid())
  userId       String
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())
  board        Board    @relation(fields: [resourceId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
}

model RecentItem {
  id           String   @id @default(uuid())
  userId       String
  resourceType String
  resourceId   String
  accessedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([accessedAt])
}

model ApiKey {
  id             String       @id @default(uuid())
  key            String       @unique
  name           String
  organizationId String
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resourceType   String?
  resourceId     String?
  details        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
  @@index([userId])
}
