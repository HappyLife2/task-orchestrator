// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Models

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  departments  Department[]
  apiKeys      ApiKey[]
  dashboards   Dashboard[]
  workforms    Workform[]
  documents    Document[]
  activityLogs ActivityLog[]
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String // Hashed
  name           String?
  avatarUrl      String?
  role           String   @default("MEMBER") // OWNER, ADMIN, MEMBER, VIEWER
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks             Task[]
  createdTasks      Task[]             @relation("TaskCreator")
  updates           Update[]
  timeEntries       TimeEntry[]
  permissions       Permission[]
  notifications     Notification[]
  favorites         Favorite[]
  recentItems       RecentItem[]
  documentVersions  DocumentVersion[]
  watchedItems      WatchedItem[]
  updateReactions   UpdateReaction[]
}

model Department {
  id             String   @id @default(uuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  boards       Board[]
}

model Board {
  id           String   @id @default(uuid())
  name         String
  description  String?
  icon         String?
  color        String?
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department  Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  groups      Group[]
  tasks       Task[]
  views       BoardView[]
  automations Automation[]
  templates   Template[]
  permissions Permission[]
  favorites   Favorite[]
  discussions Discussion[]

  // Column definitions stored as JSON. 
  // E.g. [{id: "status", type: "status", settings: {...}}, {id: "person", type: "person"}]
  columns String @default("[]") 
  
  @@index([departmentId])
}

model Group {
  id        String   @id @default(uuid())
  boardId   String
  title     String
  color     String?
  position  Int      @default(0)
  collapsed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId])
  @@index([position])
}

model Task {
  id               String    @id @default(uuid())
  name             String
  state            String    @default("ACTIVE") // ACTIVE, ARCHIVED
  boardId          String
  groupId          String?
  assignedUserId   String?
  referenceId      String?
  externalId       String? // Make unique per board or org if needed, but safer to index
  
  description      String?
  creatorId        String?
  creator          User?   @relation("TaskCreator", fields: [creatorId], references: [id])
  
  // Standard columns
  columnValues String @default("{}") // JSON string of values: { "status": "Done", "person": "user_id" }
  position     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board        Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  group        Group? @relation(fields: [groupId], references: [id])
  assignedUser User?  @relation(fields: [assignedUserId], references: [id])
  
  parentTaskId String?
  parentTask   Task?   @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks     Task[]  @relation("SubTasks")
  updates      Update[]
  timeEntries  TimeEntry[]
  watchedItems WatchedItem[]

  @@index([boardId])
  @@index([groupId])
  @@index([assignedUserId])
  @@index([referenceId])
  @@index([externalId])
  @@index([creatorId])
  @@index([position])
}

model Update {
  id        String   @id @default(uuid())
  content   String   // HTML or Markdown
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  
  // Basic reply structure (optional, but requested "people can reply to it")
  // For simplicity, we can just treat all as a flat list or use a parentId.
  // Monday.com updates are usually a feed. Replies are threaded.
  // Let's add simple threading.
  parentId  String?
  parent    Update?  @relation("UpdateReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Update[] @relation("UpdateReplies")
  reactions UpdateReaction[]

  @@index([taskId])
  @@index([userId])
}

model UpdateReaction {
  id        String   @id @default(uuid())
  updateId  String
  userId    String
  emoji     String   @default("❤️")
  createdAt DateTime @default(now())

  update    Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([updateId, userId])
  @@index([updateId])
  @@index([userId])
}

model BoardView {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  type      String   // table, kanban, calendar, timeline, chart, map, form, files
  settings  String   @default("{}") // JSON: filters, sorting, grouping, etc.
  position  Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model Dashboard {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  layout         String   @default("[]") // JSON: widget positions
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widgets      DashboardWidget[]
  permissions  Permission[]

  @@index([organizationId])
}

model DashboardWidget {
  id          String   @id @default(uuid())
  dashboardId String
  type        String   // chart, number, battery, timeline, boardView, text
  title       String
  config      String   @default("{}") // JSON: data source, chart type, etc.
  position    String   // JSON: x, y, width, height
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId ])
}

model Automation {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  trigger   String   // JSON: trigger config
  conditions String  @default("[]") // JSON: array of conditions
  actions   String   @default("[]") // JSON: array of actions
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  logs  AutomationLog[]

  @@index([boardId])
  @@index([enabled])
}

model AutomationLog {
  id           String   @id @default(uuid())
  automationId String
  taskId       String?
  status       String   // success, failed
  details      String?  // JSON: execution details
  executedAt   DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([executedAt])
}

model Template {
  id          String   @id @default(uuid())
  boardId     String?
  name        String
  description String?
  category    String?  // Project Management, CRM, Marketing, etc.
  isPublic    Boolean  @default(false)
  config      String   // JSON: full board structure
  thumbnail   String?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board Board? @relation(fields: [boardId], references: [id])

  @@index([category])
  @@index([isPublic])
}

model Workform {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  boardId        String?  // Board to submit to
  fields         String   @default("[]") // JSON: form fields
  settings       String   @default("{}") // JSON: thank you message, etc.
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions  WorkformSubmission[]

  @@index([organizationId])
}

model WorkformSubmission {
  id         String   @id @default(uuid())
  workformId String
  data       String   // JSON: submitted data
  taskId     String?  // Created task if applicable
  createdAt  DateTime @default(now())

  workform Workform @relation(fields: [workformId], references: [id], onDelete: Cascade)

  @@index([workformId])
  @@index([createdAt])
}

model Permission {
  id           String   @id @default(uuid())
  userId       String
  resourceType String   // workspace, board, dashboard
  resourceId   String
  role         String   // owner, admin, member, viewer
  settings     String   @default("{}") // JSON: custom permissions
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  board      Board?      @relation(fields: [resourceId], references: [id])
  dashboard  Dashboard?  @relation(fields: [resourceId], references: [id])

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([resourceId])
}

model TimeEntry {
  id          String    @id @default(uuid())
  taskId      String
  userId      String
  hours       Float
  description String?
  isBillable  Boolean   @default(false)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
}

model Document {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  content        String   @default("") // Rich text/HTML
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]

  @@index([organizationId])
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  content    String
  userId     String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([documentId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // mention, assignment, update, automation
  title     String
  content   String?
  link      String?  // Link to relevant item
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model WatchedItem {
  id        String   @id @default(uuid())
  userId    String
  taskId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
}

model Discussion {
  id        String   @id @default(uuid())
  boardId   String
  title     String
  content   String
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model Favorite {
  id           String   @id @default(uuid())
  userId       String
  resourceType String   // board, dashboard, task
  resourceId   String
  createdAt    DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board? @relation(fields: [resourceId], references: [id])

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
}

model RecentItem {
  id           String   @id @default(uuid())
  userId       String
  resourceType String   // board, dashboard, task, document
  resourceId   String
  accessedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([accessedAt])
}

model ApiKey {
  id             String    @id @default(uuid())
  key            String    @unique // Hashed or securely stored
  name           String
  organizationId String
  lastUsedAt     DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String   // created_board, updated_task, etc.
  resourceType   String?
  resourceId     String?
  details        String?  // JSON
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
  @@index([userId])
}
